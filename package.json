    "@atproto/oauth-client-node": "^0.5.13",
    "@atproto/oauth-types": "^0.7.7",
    "@atproto/syntax": "^0.7.7",
    "@atproto/xrpc": "^0.8.16",
    "better-sqlite3": "^13.0.3",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@atproto/lex-cli": "^0.10.16",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
